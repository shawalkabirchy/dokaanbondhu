# DokaanBondhu: every environment variable (spec 4.3). Copy this file to .env.local (git-ignored) and fill it in.
# Never put real values in this file.
#
# Supabase database URLs use the session pooler (port 5432) and end with
#   ?sslmode=verify-full&sslrootcert=<absolute path of certs/supabase-root-2021.crt>
# The mobile app's public values are not here: they live in apps/mobile/.env.development (spec 15.1).

# --- Server and worker -------------------------------------------------------------------------------
# platform_api through the session pooler (platform_api.<project-ref>)
PLATFORM_DATABASE_URL=
# platform_admin (admin CLI, worker admin jobs)
PLATFORM_ADMIN_DATABASE_URL=
# The project's postgres role (migrations)
PLATFORM_MIGRATION_DATABASE_URL=
# Passwords the roles script sets on the two roles
PLATFORM_API_PASSWORD=
PLATFORM_ADMIN_PASSWORD=
# Supabase project URL; the JWKS URL is derived from it
SUPABASE_URL=
# Admin API and the private recordings bucket; never in the app
SUPABASE_SECRET_KEY=
# 32 random bytes, base64; encrypts every stored secret
AES_KEY=
# Enables evaluation traces for requests that present it
EVAL_MODE_SECRET=
LOG_LEVEL=info
PORT=3100
# JWT_TEST_SECRET is set in CI only; leave it unset here

# --- Evaluation tools ---------------------------------------------------------------------------------
# http://localhost:3100 or the pod's address
EVAL_SERVER_URL=http://localhost:3100
EVAL_SHOP_ID=
EVAL_OWNER_EMAIL=
EVAL_OWNER_PASSWORD=
EVAL_STAFF_EMAIL=
EVAL_STAFF_PASSWORD=

# --- Provider keys: read only by the admin CLI (--secret-env), stored encrypted in ai_providers --------
CLOUDFLARE_API_TOKEN=
# <key>:<secret> of a Modal proxy token
MODAL_PROXY_TOKEN=
# Only when used
DEEPSEEK_API_KEY=
OPENAI_API_KEY=
ELEVENLABS_API_KEY=

# --- Speech worker (Modal secrets and pod settings; not read by the Node processes) -------------------
# ASR_HF_ID=
# ASR_MODEL_DIR=
# ASR_COMPUTE_TYPE=float16
# ASR_HF_REVISION=
# TTS_MODEL_ID=
# TTS_FP16=1
# TTS_MODEL_REVISION=
# SPEECH_API_KEY=
# SPEECH_VERSION=
# SPEECH_LOAD_MODELS=0 (tests only)
# HF_TOKEN=
# HF_HOME=
